	public static void populateSailor(Connection conn) {
		// Create 19,000 sailors with varied data
		String[] sailorNames = {"Jack", "Mary", "John", "Sarah", "Mike", "Lisa", "Tom", "Anna", 
				"Bob", "Emma", "David", "Kate", "Alex", "Jane", "Chris", "Lucy",
				"Sam", "Nina", "Paul", "Eva", "Mark", "Rose", "Jim", "Amy"};
		
		for (int i = 1; i <= 19000; i++) {
			String sailorName = sailorNames[(i - 1) % sailorNames.length] + i;
			int rating = (i % 10) + 1; // Ratings from 1-10
			double age = 18.0 + (i % 50); // Ages from 18-67
			
			if (insertSailor(i, sailorName, rating, age, conn) == 0) {
				System.err.println("insertion of sailor " + i + " failed");
				break;
			}
			if (i % 1000 == 0) {
				System.out.println("Inserted " + i + " sailors");
			}
		}
		System.out.println("Sailor population completed: 19,000 sailors");
	}

	public static void populateBoat(Connection conn) {
		// Create 3,000 boats with varied colors
		String[] boatTypes = {"Yacht", "Sailboat", "Speedboat", "Catamaran", "Dinghy", 
				"Cruiser", "Fishing", "Racing", "Motor", "Paddle"};
		String[] colors = {"red", "green", "blue", "white", "black", "yellow"};
		
		for (int i = 1; i <= 3000; i++) {
			String boatName = boatTypes[(i - 1) % boatTypes.length] + i;
			String color = colors[(i - 1) % colors.length];
			
			// Ensure boat 103 exists and is red (for Query 3A)
			if (i == 103) {
				color = "red";
			}
			
			if (insertBoat(i, boatName, color, conn) == 0) {
				System.err.println("insertion of boat " + i + " failed");
				break;
			}
			if (i % 500 == 0) {
				System.out.println("Inserted " + i + " boats");
			}
		}
		System.out.println("Boat population completed: 3,000 boats");
	}

	@SuppressWarnings("deprecation")
	public static void populateReserves(Connection conn) {
		// Create 35,000 reserves with strategic distribution
		// Use a set-like approach to avoid duplicate (sid, bid) pairs
		java.util.Set<String> usedCombinations = new java.util.HashSet<>();
		int reserveCount = 0;
		
		// Helper method to create unique reserve key
		java.util.function.Function<int[], String> makeKey = (pair) -> pair[0] + "," + pair[1];
		
		// 1. Ensure boat 103 has many reservations (for Query 3A)
		for (int sailorId = 1; sailorId <= 1000 && reserveCount < 35000; sailorId++) {
			String key = makeKey.apply(new int[]{sailorId, 103});
			if (!usedCombinations.contains(key)) {
				usedCombinations.add(key);
				reserveCount++;
				Date reserveDate = new Date(100 + (sailorId % 25), (sailorId % 12), (sailorId % 28) + 1);
				if (insertReserves(sailorId, 103, reserveDate, conn) == 0) {
					System.err.println("insertion of reserve " + reserveCount + " failed");
					break;
				}
			}
		}
		
		// 2. Create reservations for red boats (for Query 3B)
		// Red boats are those with IDs: 1, 7, 13, 19, 25, ... (every 6th boat starting from 1)
		for (int boatId = 1; boatId <= 3000 && reserveCount < 35000; boatId += 6) {
			// Each red boat gets reservations from multiple sailors
			for (int sailorOffset = 0; sailorOffset < 15 && reserveCount < 35000; sailorOffset++) {
				int sailorId = ((boatId - 1) * 15 + sailorOffset) % 19000 + 1;
				String key = makeKey.apply(new int[]{sailorId, boatId});
				if (!usedCombinations.contains(key)) {
					usedCombinations.add(key);
					reserveCount++;
					Date reserveDate = new Date(100 + (reserveCount % 25), (reserveCount % 12), (reserveCount % 28) + 1);
					if (insertReserves(sailorId, boatId, reserveDate, conn) == 0) {
						System.err.println("insertion of reserve " + reserveCount + " failed");
						break;
					}
				}
			}
		}
		
		// 3. Create reservations for green boats (for Query 3C)
		// Green boats are those with IDs: 2, 8, 14, 20, 26, ... (every 6th boat starting from 2)
		for (int boatId = 2; boatId <= 3000 && reserveCount < 35000; boatId += 6) {
			// Each green boat gets reservations from multiple sailors
			for (int sailorOffset = 0; sailorOffset < 12 && reserveCount < 35000; sailorOffset++) {
				int sailorId = ((boatId - 2) * 12 + sailorOffset) % 19000 + 1;
				String key = makeKey.apply(new int[]{sailorId, boatId});
				if (!usedCombinations.contains(key)) {
					usedCombinations.add(key);
					reserveCount++;
					Date reserveDate = new Date(100 + (reserveCount % 25), (reserveCount % 12), (reserveCount % 28) + 1);
					if (insertReserves(sailorId, boatId, reserveDate, conn) == 0) {
						System.err.println("insertion of reserve " + reserveCount + " failed");
						break;
					}
				}
			}
		}
		
		// 4. Create reservations for sailors who reserve BOTH red and green boats (for Query 3C)
		// These sailors will appear in Query 3C results
		for (int sailorId = 1; sailorId <= 2000 && reserveCount < 35000; sailorId++) {
			// Reserve a red boat
			int redBoatId = ((sailorId - 1) % 500) * 6 + 1; // Red boat IDs
			if (redBoatId <= 3000) {
				String redKey = makeKey.apply(new int[]{sailorId, redBoatId});
				if (!usedCombinations.contains(redKey)) {
					usedCombinations.add(redKey);
					reserveCount++;
					Date redDate = new Date(101 + (sailorId % 20), (sailorId % 12), (sailorId % 28) + 1);
					if (insertReserves(sailorId, redBoatId, redDate, conn) == 0) {
						System.err.println("insertion of reserve " + reserveCount + " failed");
						break;
					}
				}
			}
			
			// Reserve a green boat (same sailor)
			if (reserveCount < 35000) {
				int greenBoatId = ((sailorId - 1) % 500) * 6 + 2; // Green boat IDs
				if (greenBoatId <= 3000) {
					String greenKey = makeKey.apply(new int[]{sailorId, greenBoatId});
					if (!usedCombinations.contains(greenKey)) {
						usedCombinations.add(greenKey);
						reserveCount++;
						Date greenDate = new Date(102 + (sailorId % 20), (sailorId % 12), (sailorId % 28) + 1);
						if (insertReserves(sailorId, greenBoatId, greenDate, conn) == 0) {
							System.err.println("insertion of reserve " + reserveCount + " failed");
							break;
						}
					}
				}
			}
		}
		
		// 5. Fill remaining reservations with unique random data
		int attempts = 0;
		while (reserveCount < 35000 && attempts < 100000) {
			attempts++;
			int sailorId = (reserveCount * 7 + attempts) % 19000 + 1;
			int boatId = (reserveCount * 13 + attempts) % 3000 + 1;
			String key = makeKey.apply(new int[]{sailorId, boatId});
			
			if (!usedCombinations.contains(key)) {
				usedCombinations.add(key);
				reserveCount++;
				Date reserveDate = new Date(90 + (reserveCount % 30), (reserveCount % 12), (reserveCount % 28) + 1);
				if (insertReserves(sailorId, boatId, reserveDate, conn) == 0) {
					System.err.println("insertion of reserve " + reserveCount + " failed");
					break;
				}
				
				if (reserveCount % 5000 == 0) {
					System.out.println("Inserted " + reserveCount + " reserves");
				}
			}
		}
		
		System.out.println("Reserves population completed: " + reserveCount + " reserves");
		System.out.println("Total unique (sailor, boat) combinations used: " + usedCombinations.size());
	}

