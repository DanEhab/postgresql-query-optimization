	@SuppressWarnings("deprecation")
	public static void populateEmployee(Connection conn) {
		// Create 16,000 employees total
		// Insert "employee1" (lowercase) - needed for queries 2A (top-level manager, no supervisor)
		insertEmployeeWithNullSuper("Employee", "M", "employee1", 1, new Date(80, 0, 15), "123 Main St", "M", 50000, 1, conn);
		
		// Insert more employees with last name "employee1" for better query results (batch 1: 2-500)
		for (int i = 2; i <= 500; i++) {
			String sex = (i % 2 == 0) ? "F" : "M";
			int salary = 30000 + (i * 100); // Varied salaries
			// FIXED: Put most "employee1" employees in department 10 to make it have >5 employees for Query 2E
			int dno = (i <= 400) ? 10 : (((i - 1) % 149) + 1); // First 400 go to dept 10, rest distributed
			int superSSN = (i > 10) ? ((i - 1) % 100) + 1 : 1; // Reference existing employees or top manager
			insertEmployee("Employee" + i, "M" + i, "employee1", i, new Date(75 + (i % 20), (i % 12), (i % 28) + 1), 
					"address" + i, sex, salary, superSSN, dno, conn);
		}
		
		// Insert regular employees with varied data (batch 2: 501-8000)
		for (int i = 501; i <= 8000; i++) {
			String sex = (i % 3 == 0) ? "F" : "M";
			String lastName = "Employee" + ((i % 500) + 1); // Create some duplicate last names
			int salary = 25000 + (i * 10); // Varied salaries from 30k to 105k
			int dno = ((i - 1) % 150) + 1; // Distribute across departments 1-150
			int superSSN = ((i - 1) % 500) + 1; // Valid supervision hierarchy
			insertEmployee("Emp" + i, "M" + i, lastName, i, new Date(70 + (i % 30), (i % 12), (i % 28) + 1), 
					"address" + i, sex, salary, superSSN, dno, conn);
		}
		
		// Add more regular employees (batch 3: 8001-15000)
		for (int i = 8001; i <= 15000; i++) {
			String sex = (i % 2 == 1) ? "M" : "F";
			String lastName = "Worker" + ((i % 1000) + 1);
			int salary = 35000 + (i % 50000); // Wide salary range
			int dno = ((i - 1) % 150) + 1; // Distribute across departments 1-150
			int superSSN = ((i - 1) % 1000) + 1; // Valid supervision hierarchy
			insertEmployee("Work" + i, "W" + i, lastName, i, new Date(65 + (i % 35), (i % 12), (i % 28) + 1), 
					"address" + i, sex, salary, superSSN, dno, conn);
		}
		
		// Add employees specifically for department 5 with VERY LOW salaries (for query 2B to return hundreds)
		for (int i = 15001; i <= 15100; i++) {
			String sex = (i % 2 == 0) ? "F" : "M";
			int salary = 15000 + ((i - 15000) * 50); // Very low salaries 15k to 20k (lower than before)
			int superSSN = 5; // Report to employee with ssn = 5
			insertEmployee("LowPay" + i, "L" + i, "LowSalary" + i, i, new Date(85, (i % 12), (i % 28) + 1), 
					"address" + i, sex, salary, superSSN, 5, conn);
		}
		
		// Add MORE employees with MEDIUM salaries for Query 2B (batch 4b: 15101-15500)
		for (int i = 15101; i <= 15500; i++) {
			String sex = (i % 2 == 1) ? "M" : "F";
			int salary = 21000 + ((i - 15100) * 25); // Medium salaries 21k to 31k
			int dno = ((i - 1) % 149) + 2; // Distribute across departments 2-150 (avoid dept 5)
			int superSSN = ((i - 1) % 500) + 1;
			insertEmployee("Med" + i, "M" + i, "MedSalary" + i, i, new Date(80, (i % 12), (i % 28) + 1), 
					"address" + i, sex, salary, superSSN, dno, conn);
		}
		
		// Fill remaining slots to reach 16,000 (batch 5: 15501-16000)
		for (int i = 15501; i <= 16000; i++) {
			String sex = (i % 3 == 0) ? "F" : "M";
			String lastName = "Staff" + ((i % 200) + 1);
			int salary = 40000 + (i % 60000); // High salary range for query 2E
			int dno = ((i - 1) % 150) + 1; // Distribute across departments 1-150
			int superSSN = ((i - 1) % 2000) + 1; // Valid supervision hierarchy
			insertEmployee("Staff" + i, "S" + i, lastName, i, new Date(75 + (i % 25), (i % 12), (i % 28) + 1), 
					"address" + i, sex, salary, superSSN, dno, conn);
		}
		
		System.out.println("Employee population completed: 16,000 employees");
	}

