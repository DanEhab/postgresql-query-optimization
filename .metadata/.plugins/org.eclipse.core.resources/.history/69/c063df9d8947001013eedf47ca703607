	public static void populateProject(Connection conn) {
		// Create 9,200 projects distributed across 150 departments
		String[] projectNames = {"DB_System", "Web_App", "Mobile_App", "AI_Research", 
				"Cloud_Migrate", "Security", "Performance", "UI_Design",
				"Analytics", "ML_Project", "DevOps", "API_Dev",
				"Network", "BI_System", "Portal", "Payment",
				"Inventory", "HR_System", "CRM", "Ecommerce",
				"Document", "Workflow", "QA_Test", "Framework"};
		
		String[] locations = {"Location_A", "Location_B", "Location_C", "Location_D", "Location_E",
				"Location_F", "Location_G", "Location_H", "Location_I", "Location_J",
				"Remote", "Hybrid", "OnSite", "Global", "Regional"};
		
		// Create 9,200 projects distributed across 150 departments
		int projectId = 1;
		for (int deptNum = 1; deptNum <= 150; deptNum++) {
			// Each department gets approximately 61-62 projects (9200/150 ≈ 61.33)
			int numProjects = (deptNum <= 50) ? 62 : 61; // First 50 departments get 62, rest get 61
			
			for (int j = 0; j < numProjects && projectId <= 9200; j++) {
				// Keep project name under 20 characters
				String projectName = projectNames[projectId % projectNames.length] + "_" + projectId;
				String location = locations[projectId % locations.length] + "_" + ((projectId % 100) + 1);
				insertProject(projectName, projectId, location, deptNum, conn);
				projectId++;
			}
		}
		System.out.println("Project population completed: " + (projectId - 1) + " projects");
	}

	public static void populateWorksOn(Connection conn) {
		// FIXED: Limit employee1 workers to specific projects for Query 2A to return hundreds instead of 9200
		
		// Only first 100 employees with "employee1" lastname work on projects (instead of 500)
		// And they only work on first 300 projects (instead of all 9200)
		for (int empId = 1; empId <= 100; empId++) { // Reduced from 500 to 100
			// Each employee works on 2-4 projects from LIMITED project range
			int numProjects = 2 + (empId % 3);
			for (int j = 0; j < numProjects; j++) {
				int projectId = ((empId + j - 1) % 300) + 1; // Only first 300 projects (instead of 1000)
				int hours = 10 + ((empId + j) % 30); // 10-40 hours
				insertWorksOn(empId, projectId, hours, conn);
			}
		}
		
		// Regular employees work on projects too
		for (int empId = 501; empId <= 5000; empId++) {
			// Each employee works on 1-3 projects
			int numProjects = 1 + (empId % 3);
			for (int j = 0; j < numProjects; j++) {
				int projectId = ((empId + j - 1) % 2000) + 1;
				int hours = 5 + ((empId + j) % 35); // 5-40 hours
				insertWorksOn(empId, projectId, hours, conn);
			}
		}
		
		// Low salary employees in department 5 also work on projects
		for (int empId = 15001; empId <= 15100; empId++) {
			int projectId = ((empId - 15000) % 100) + 1;
			int hours = 20 + ((empId - 15000) % 20); // 20-40 hours
			insertWorksOn(empId, projectId, hours, conn);
		}
		
		System.out.println("Works_on population completed");
	}

	@SuppressWarnings("deprecation")
	public static void populateDependent(Connection conn) {
		// FIXED: Create many more name and sex matches for Query 2C to return hundreds
		
		String[] relationships = {"Son", "Daughter", "Spouse", "Father", "Mother"};
		String[] commonNames = {"John", "Mary", "James", "Patricia", "Robert", "Jennifer", 
				"Michael", "Linda", "William", "Elizabeth", "David", "Barbara", "Richard", "Susan"};
		
		int dependentCount = 0;
		
		// Create MANY MORE matching names and sex for Query 2C (first 1000 employees)
		for (int empId = 1; empId <= 1000; empId++) {
			// Each employee has 1-3 dependents
			int numDependents = 1 + (empId % 3);
			
			for (int j = 0; j < numDependents; j++) {
				dependentCount++;
				String dependentName;
				String sex;
				String relationship = relationships[dependentCount % relationships.length];
				
				// For query 2C: Create MANY MORE name and sex matches
				if (empId <= 500) {
					// For first 500 employees, create dependents with EXACT matching first names and sex
					if (empId <= 100) {
						dependentName = "Employee"; // Matches "Employee" first name for employees 1-100
					} else if (empId <= 500) {
						dependentName = "Employee" + empId; // Matches "Employee101", "Employee102", etc.
					} else {
						dependentName = "Emp" + empId; // Matches "Emp501", "Emp502", etc.
					}
					// Match employee's sex pattern EXACTLY
					sex = (empId % 2 == 0) ? "F" : "M";
				} else if (empId <= 800) {
					// For employees 501-800, create more matches with "Emp" pattern
					dependentName = "Emp" + empId;
					sex = (empId % 3 == 0) ? "F" : "M"; // Match the employee sex pattern
				} else {
					// For employees 801-1000, create matches with "Work" pattern
					dependentName = "Work" + empId;
					sex = (empId % 2 == 1) ? "M" : "F"; // Match the employee sex pattern
				}
				
				Date birthDate = new Date(85 + (dependentCount % 20), (dependentCount % 12), (dependentCount % 28) + 1);
				insertDependent(empId, dependentName, sex, birthDate, relationship, conn);
			}
		}
		
		// Add more regular dependents for remaining employees (for Query 2D)
		for (int empId = 1001; empId <= 1500; empId++) {
			int numDependents = 1 + (empId % 2); // 1-2 dependents
			
			for (int j = 0; j < numDependents; j++) {
				dependentCount++;
				String dependentName = commonNames[dependentCount % commonNames.length];
				String sex = (dependentCount % 2 == 0) ? "F" : "M";
				String relationship = relationships[dependentCount % relationships.length];
				
				Date birthDate = new Date(85 + (dependentCount % 20), (dependentCount % 12), (dependentCount % 28) + 1);
				insertDependent(empId, dependentName, sex, birthDate, relationship, conn);
			}
		}
		
		System.out.println("Dependent population completed with " + dependentCount + " dependents");
	}

