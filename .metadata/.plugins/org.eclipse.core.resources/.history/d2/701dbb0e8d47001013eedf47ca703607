				"COMM", "EDUC", "NURS", "PHAR", "DENT", "VET", "AGR", "FOR", "ENV", "MAR",
				"AERO", "NANO", "BIOM", "SOFT", "CYBER", "DATA", "AI", "ROBO", "ENER", "MAT",
				"CERAM", "PETRO", "MIN", "GEO", "OCEAN", "SPACE", "NUCL", "SOLAR", "WIND", "HYDRO"};
		
		int studentId = 1;
		int instructorCount = 1; // Track instructor IDs for advisor assignment
		
		for (int deptIndex = 0; deptIndex < 60; deptIndex++) {
			String deptName = deptNames[deptIndex];
			// Each department gets at least 1100 students (varying 1100-1150)
			int numStudents = 1100 + (deptIndex % 51); // 1100-1150 students per department
			
			// Calculate instructor range for this department
			int deptInstructors = 10 + (deptIndex % 26); // Same calculation as in populateInstructor
			int instructorStart = instructorCount;
			int instructorEnd = instructorCount + deptInstructors - 1;
			
			for (int j = 1; j <= numStudents; j++) {
				String studentName = "Student_" + deptName + "_" + j;
				int totalCredit = 30 + (studentId % 120); // Credits from 30-150
				// Assign advisor from department's instructors
				int advisorId = instructorStart + ((j - 1) % deptInstructors);
				
				if (insertStudent(studentId, studentName, totalCredit, deptName, advisorId, conn) == 0) {
					System.err.println("insertion of student " + studentId + " failed");
					return;
				}
				studentId++;
			}
			
			instructorCount = instructorEnd + 1; // Move to next department's instructors
			
			if (deptIndex % 5 == 4) {
				System.out.println("Inserted students for " + (deptIndex + 1) + " departments, total students: " + (studentId - 1));
			}
		}
		System.out.println("Student population completed: " + (studentId - 1) + " students");
	}

