	public static void populateSection(Connection conn) {
		// Create sections for courses with strategic focus on semester 5, year 2025 for Query 1A
		int sectionId = 1;
		
		// We'll create ~3000 sections total to ensure good distribution
		for (int courseId = 1; courseId <= 1800 && sectionId <= 3000; courseId++) {
			// Each course gets 1-2 sections
			int numSections = 1 + (courseId % 2);
			
			for (int secNum = 1; secNum <= numSections && sectionId <= 3000; secNum++) {
				// Strategic semester and year assignment for Query 1A
				int semester, year;
				if (sectionId <= 800) {
					// First 800 sections are semester 5, year 2025 (for Query 1A)
					semester = 5;
					year = 2025;
				} else {
					// Other sections have varied semesters and years
					semester = 1 + (sectionId % 8); // Semesters 1-8
					year = 2020 + (sectionId % 10); // Years 2020-2029
				}
				
				// Assign instructor (cycle through available instructors)
				int instructorId = 1 + ((sectionId - 1) % 1320); // Assuming ~1320 instructors
				
				// Assign classroom
				int classroomBuilding = 1 + ((sectionId - 1) % 60); // 60 buildings
				int classroomRoom = 1 + ((sectionId - 1) % 2000); // 2000 rooms
				
				if (insertSection(sectionId, semester, year, instructorId, courseId, classroomBuilding, classroomRoom, conn) == 0) {
					System.err.println("insertion of section " + sectionId + " failed");
					return;
				}
				sectionId++;
			}
			
			if (courseId % 500 == 0) {
				System.out.println("Created sections for " + courseId + " courses, total sections: " + (sectionId - 1));
			}
		}
		System.out.println("Section population completed: " + (sectionId - 1) + " sections");
	}

	public static void populateTakes(Connection conn) {
		// Strategic enrollment focusing on MET students in semester 5, year 2025 sections for Query 1A
		
		// MET department students: IDs 1101-2250 (approximately 1150 students)
		// Semester 5, year 2025 sections: IDs 1-800
		
		int recordCount = 0;
		
		// 1. Enroll many MET students in semester 5, year 2025 sections (for Query 1A results)
		for (int metStudentId = 1101; metStudentId <= 2250 && recordCount < 50000; metStudentId++) {
			// Each MET student takes 3-5 sections from semester 5, year 2025
			int numSections = 3 + (metStudentId % 3); // 3-5 sections per student
			
			for (int i = 0; i < numSections && recordCount < 50000; i++) {
				int sectionId = 1 + ((metStudentId + i) % 800); // Sections 1-800 are sem 5, year 2025
				double grade = 1.0 + ((metStudentId + i) % 4) + 0.3; // Grades 1.3-4.3
				
				if (insertTakes(metStudentId, sectionId, grade, conn) == 0) {
					System.err.println("insertion of takes record failed");
					return;
				}
				recordCount++;
			}
		}
		
		// 2. Regular enrollment for other students
		for (int studentId = 1; studentId <= 66000 && recordCount < 100000; studentId++) {
			// Skip MET students (already enrolled above)
			if (studentId >= 1101 && studentId <= 2250) continue;
			
			// Each student takes 2-4 sections
			int numSections = 2 + (studentId % 3);
			
			for (int i = 0; i < numSections && recordCount < 100000; i++) {
				// Regular distribution across all sections
				int sectionId = 1 + ((studentId + i) % 3000);
				double grade = 1.0 + ((studentId + i) % 4) + 0.5; // Grades 1.5-4.5
				
				if (insertTakes(studentId, sectionId, grade, conn) == 0) {
					System.err.println("insertion of takes record failed");
					return;
				}
				recordCount++;
				
				if (recordCount % 10000 == 0) {
					System.out.println("Inserted " + recordCount + " takes records");
				}
			}
		}
		
		System.out.println("Takes population completed: " + recordCount + " records");
	}

	public static void populateSectionTime(Connection conn) {
		// Assign time slots to sections
		// We have ~132 time slots and ~3000 sections
		
		for (int sectionId = 1; sectionId <= 3000; sectionId++) {
			// Each section gets 1-2 time slots
			int numTimeSlots = 1 + (sectionId % 2);
			
			for (int i = 0; i < numTimeSlots; i++) {
				int timeSlotId = 1 + ((sectionId + i) % 132); // Cycle through available time slots
				
				if (insertSectionTime(timeSlotId, sectionId, conn) == 0) {
					System.err.println("insertion of section_time " + sectionId + " failed");
					return;
				}
			}
			
			if (sectionId % 1000 == 0) {
				System.out.println("Assigned time slots for " + sectionId + " sections");
			}
		}
		System.out.println("Section time population completed for 3000 sections");
	}

