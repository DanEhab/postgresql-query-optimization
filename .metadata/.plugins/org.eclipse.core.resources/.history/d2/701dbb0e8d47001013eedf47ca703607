	@SuppressWarnings("deprecation")
	public static void populateTimeSlot(Connection conn) {
		// Create diverse time slots for sections
		String[] days = {"Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
		int timeSlotId = 1;
		
		// Create time slots for different times of day
		for (int day = 0; day < days.length; day++) {
			for (int startHour = 8; startHour <= 18; startHour += 2) { // 8AM to 6PM, every 2 hours
				for (int duration = 1; duration <= 2; duration++) { // 1 or 2 hour slots
					Time startTime = new Time(startHour, 0, 0);
					Time endTime = new Time(startHour + duration, 0, 0);
					
					if (insertTimeSlot(timeSlotId, days[day], startTime, endTime, conn) == 0) {
						System.err.println("insertion of time slot " + timeSlotId + " failed");
						return;
					}
					timeSlotId++;
				}
			}
		}
		System.out.println("Time slot population completed: " + (timeSlotId - 1) + " time slots");
	}

