			int mgrSSN = i; // Use the first 10 employees as managers
			insertDepartment("Department" + i, i, mgrSSN, new Date(90 + (i % 10), (i % 12), 1), conn);
		}
		System.out.println("Department population completed");
	}

	public static void populateDeptLocations(Connection conn) {
		// Create multiple locations for each department
		String[] locations = {"New York", "Los Angeles", "Chicago", "Houston", "Phoenix", 
				"Philadelphia", "San Antonio", "San Diego", "Dallas", "San Jose",
				"Austin", "Jacksonville", "Fort Worth", "Columbus", "Charlotte"};
		
		for (int i = 1; i <= 10; i++) {
			// Each department has 2-3 locations
			for (int j = 0; j < 3; j++) {
				String location = locations[(i * 3 + j - 1) % locations.length];
				insertDeptLocations(i, location, conn);
			}
		}
		System.out.println("Department locations population completed");
	}

	public static void populateProject(Connection conn) {
		// Create projects managed by departments that have "employee1" as manager
		String[] projectNames = {"Database System", "Web Application", "Mobile App", "AI Research", 
				"Cloud Migration", "Security Audit", "Performance Optimization", "UI Redesign",
				"Data Analytics", "Machine Learning", "DevOps Pipeline", "API Development"};
		
		// Create projects for departments 1-10
		int projectId = 1;
		for (int deptNum = 1; deptNum <= 10; deptNum++) {
			// Each department gets 5-8 projects
			int numProjects = 5 + (deptNum % 4);
			for (int j = 0; j < numProjects; j++) {
				String projectName = projectNames[projectId % projectNames.length] + " " + projectId;
				String location = "Location" + ((projectId % 10) + 1);
				insertProject(projectName, projectId, location, deptNum, conn);
				projectId++;
			}
		}
		System.out.println("Project population completed");
	}

	public static void populateWorksOn(Connection conn) {
		// Ensure employees with last name "employee1" work on multiple projects
		// This is important for query 2A
		
		// First, make sure the "employee1" employees work on various projects
		for (int empId = 1; empId <= 50; empId++) { // All employees with lname "employee1"
			// Each employee works on 2-4 projects
			int numProjects = 2 + (empId % 3);
			for (int j = 0; j < numProjects; j++) {
				int projectId = ((empId + j - 1) % 70) + 1; // Distribute across available projects
				int hours = 10 + ((empId + j) % 30); // 10-40 hours
				insertWorksOn(empId, projectId, hours, conn);
			}
		}
		
		// Regular employees work on projects too
		for (int empId = 51; empId <= 1000; empId++) {
			// Each employee works on 1-3 projects
			int numProjects = 1 + (empId % 3);
			for (int j = 0; j < numProjects; j++) {
				int projectId = ((empId + j - 1) % 70) + 1;
				int hours = 5 + ((empId + j) % 35); // 5-40 hours
				insertWorksOn(empId, projectId, hours, conn);
			}
		}
		
		// Low salary employees in department 5 also work on projects
		for (int empId = 1001; empId <= 1020; empId++) {
			int projectId = ((empId - 1000) % 70) + 1;
			int hours = 20 + ((empId - 1000) % 20); // 20-40 hours
			insertWorksOn(empId, projectId, hours, conn);
		}
		
		System.out.println("Works_on population completed");
	}

	@SuppressWarnings("deprecation")
	public static void populateDependent(Connection conn) {
		// Create dependents for employees - important for queries 2C and 2D
		// Query 2C looks for employees whose first name matches dependent name and same sex
		// Query 2D looks for employees who have dependents
		
		String[] relationships = {"Son", "Daughter", "Spouse", "Father", "Mother"};
		String[] commonNames = {"John", "Mary", "James", "Patricia", "Robert", "Jennifer", 
				"Michael", "Linda", "William", "Elizabeth", "David", "Barbara", "Richard", "Susan"};
		
		int dependentCount = 0;
		
		// Ensure many employees have dependents (for query 2D to return hundreds of rows)
		for (int empId = 1; empId <= 800; empId++) {
			// Each employee has 1-3 dependents
			int numDependents = 1 + (empId % 3);
			
			for (int j = 0; j < numDependents; j++) {
				dependentCount++;
				String dependentName;
				String sex;
				String relationship = relationships[dependentCount % relationships.length];
				
				// For query 2C: Some dependents should have same name and sex as employee
				if (empId <= 50 && j == 0) {
					// For "employee1" employees, create dependents with matching first names
					dependentName = "Employee"; // Matches their first name
					sex = (empId % 2 == 1) ? "M" : "F"; // Match employee's sex pattern
				} else if (empId <= 200 && dependentCount % 5 == 0) {
					// Create some name matches for regular employees
					dependentName = "Emp" + empId; // Matches their first name pattern
					sex = (empId % 3 == 0) ? "F" : "M"; // Match employee's sex pattern
				} else {
					// Regular dependents with common names
					dependentName = commonNames[dependentCount % commonNames.length];
					sex = (dependentCount % 2 == 0) ? "F" : "M";
				}
				
				Date birthDate = new Date(85 + (dependentCount % 20), (dependentCount % 12), (dependentCount % 28) + 1);
				insertDependent(empId, dependentName, sex, birthDate, relationship, conn);
			}
		}
		
		System.out.println("Dependent population completed with " + dependentCount + " dependents");
	}

	public static void insertSchema2(Connection connection) {
		populateEmployee(connection);
		populateDepartment(connection);
		populateDeptLocations(connection);
		populateProject(connection);
		populateWorksOn(connection);
		populateDependent(connection);
	}

