	@SuppressWarnings("deprecation")
	public static void populateEmployee(Connection conn) {
		// First, modify the insertEmployee method to handle NULL values for superSSN when 0 is passed
		// Create employees with specific names needed for queries
		// Insert "employee1" (lowercase) - needed for queries 2A (top-level manager, no supervisor)
		insertEmployeeWithNullSuper("Employee", "M", "employee1", 1, new Date(80, 0, 15), "123 Main St", "M", 50000, 1, conn);
		
		// Insert more employees with last name "employee1" for better query results
		for (int i = 2; i <= 50; i++) {
			String sex = (i % 2 == 0) ? "F" : "M";
			int salary = 30000 + (i * 1000); // Varied salaries
			int dno = ((i - 1) % 10) + 1; // Distribute across departments 1-10
			int superSSN = (i > 10) ? ((i - 1) % 10) + 1 : 1; // Reference existing employees or top manager
			insertEmployee("Employee" + i, "M" + i, "employee1", i, new Date(75 + (i % 20), (i % 12), (i % 28) + 1), 
					"address" + i, sex, salary, superSSN, dno, conn);
		}
		
		// Insert regular employees with varied data
		for (int i = 51; i <= 1000; i++) {
			String sex = (i % 3 == 0) ? "F" : "M";
			String lastName = "Employee" + ((i % 100) + 1); // Create some duplicate last names
			int salary = 25000 + (i * 100); // Varied salaries from 30k to 125k
			int dno = ((i - 1) % 10) + 1; // Distribute across departments 1-10
			int superSSN = ((i - 1) % 50) + 1; // Valid supervision hierarchy
			insertEmployee("Emp" + i, "M" + i, lastName, i, new Date(70 + (i % 30), (i % 12), (i % 28) + 1), 
					"address" + i, sex, salary, superSSN, dno, conn);
		}
		
		// Add employees specifically for department 5 with lower salaries (for query 2B)
		for (int i = 1001; i <= 1020; i++) {
			String sex = (i % 2 == 0) ? "F" : "M";
			int salary = 20000 + ((i - 1000) * 500); // Salaries 20k to 30k
			int superSSN = 5; // Report to employee with ssn = 5
			insertEmployee("LowPay" + i, "L" + i, "LowSalary" + i, i, new Date(85, (i % 12), (i % 28) + 1), 
					"address" + i, sex, salary, superSSN, 5, conn);
		}
		
		System.out.println("Employee population completed");
	}

	@SuppressWarnings("deprecation")
	public static void populateDepartment(Connection conn) {
