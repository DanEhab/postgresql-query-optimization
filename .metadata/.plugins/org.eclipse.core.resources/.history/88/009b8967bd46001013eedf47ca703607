	public static void populateStudent(Connection conn) {
//		for (int i = 1; i < 10000; i++) {
//			if (insertStudent(i, "name" + i, i, "CS" + i, i, conn) == 0) {
//				System.err.println("insertion of record " + i + " failed");
//				break;
//			} else
