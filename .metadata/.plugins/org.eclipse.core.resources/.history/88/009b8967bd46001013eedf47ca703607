//		}
		int id = 1;
		int instructorId = 1;
		for (int i = 1; i <= 60; i++) {
			String dept = (i == 1) ? "MET" : "D" + i;
			int num = 1100 + rand.nextInt(101); // 1100 to 1200
			int advisorStart = instructorId;
			int advisorEnd = Math.min(advisorStart + 34, 1000); // Ensure advisors are in range 1–1000
			for (int j = 0; j < num; j++) {
				int advisor = advisorStart + rand.nextInt(Math.max(1, advisorEnd - advisorStart + 1));
				insertStudent(id, dept + "_Stud" + id, rand.nextInt(150), dept, advisor, conn);
				id++;
			}
			instructorId += 35; // Move to next block
			if (instructorId > 1000) instructorId = 1; // Wrap around if we exceed limit
		}
	}
