	@SuppressWarnings("deprecation")
	public static void populateMovie(Connection conn) {
		// Create 100,000 movies with specific titles for queries
		String[] movieTitles = {"Action Movie", "Comedy Film", "Drama Story", "Horror Night", 
				"Romance Tale", "Sci-Fi Future", "Thriller Hunt", "Adventure Quest",
				"Mystery Case", "Fantasy World", "War Film", "Crime Story",
				"Documentary", "Animation", "Musical", "Western"};
		
		String[] languages = {"English", "Spanish", "French", "German", "Italian", "Japanese"};
		String[] countries = {"US", "UK", "FR", "DE", "IT", "JP"};
		
		for (int i = 1; i <= 100000; i++) {
			String title;
			
			// Create specific movies for queries
			if (i <= 10) {
				title = "Toy Story"; // For Query 4A
			} else if (i <= 20) {
				title = "Titanic"; // For Query 4B
			} else {
				title = movieTitles[(i - 1) % movieTitles.length] + " " + i;
			}
			
			int year = 1990 + (i % 35); // Years from 1990-2024
			int time = 90 + (i % 120); // Movie length 90-210 minutes
			String lang = languages[(i - 1) % languages.length];
			String country = countries[(i - 1) % countries.length];
			Date releaseDate = new Date(year - 1900, (i % 12), (i % 28) + 1);
			
			if (insertMovie(i, title, year, time, lang, releaseDate, country, conn) == 0) {
				System.err.println("insertion of movie " + i + " failed");
				break;
			}
			
			if (i % 10000 == 0) {
				System.out.println("Inserted " + i + " movies");
			}
		}
		System.out.println("Movie population completed: 100,000 movies");
	}

