	public static void populateRating(Connection conn) {
		// Create strategic movie-reviewer ratings for meaningful query results
		// We have 5,000 reviewers from populateReviewer method
		HashSet<String> addedRatings = new HashSet<>();
		
		// 1. Toy Story movies (IDs 1-10) get many ratings
		for (int movieId = 1; movieId <= 10; movieId++) {
			// Each Toy Story movie gets 200 ratings from different reviewers (reduced from 500)
			for (int reviewerId = 1; reviewerId <= 200; reviewerId++) {
				String key = movieId + "-" + reviewerId;
				if (!addedRatings.contains(key)) {
					int stars = 3 + (movieId + reviewerId) % 3; // Stars: 3-5 (good ratings)
					int numRatings = 10 + ((movieId * reviewerId) % 90); // 10-99 ratings per reviewer
					
					if (insertRating(movieId, reviewerId, stars, numRatings, conn) == 0) {
						System.err.println("insertion of Toy Story rating failed");
						break;
					}
					addedRatings.add(key);
				}
			}
		}
		
		// 2. Titanic movies (IDs 11-20) get many ratings  
		for (int movieId = 11; movieId <= 20; movieId++) {
			// Each Titanic movie gets 150 ratings from different reviewers (reduced from 400)
			for (int reviewerId = 201; reviewerId <= 350; reviewerId++) {
				String key = movieId + "-" + reviewerId;
				if (!addedRatings.contains(key)) {
					int stars = 3 + ((movieId + reviewerId) % 3); // Stars: 3-5 (good ratings)
					int numRatings = 15 + ((movieId * reviewerId) % 85); // 15-99 ratings per reviewer
					
					if (insertRating(movieId, reviewerId, stars, numRatings, conn) == 0) {
						System.err.println("insertion of Titanic rating failed");
						break;
					}
					addedRatings.add(key);
				}
			}
		}
		
		// 3. Quentin Tarantino movies (IDs 21-500) get premium ratings
		for (int movieId = 21; movieId <= 500; movieId++) {
			// Each Tarantino movie gets 8-15 ratings (reduced from 20-50)
			int ratingCount = 8 + (movieId % 8); // 8-15 ratings per movie
			
			for (int ratingOffset = 0; ratingOffset < ratingCount; ratingOffset++) {
				int reviewerId = 351 + ((movieId * ratingCount + ratingOffset) % 4650); // Use reviewers 351-5000
				String key = movieId + "-" + reviewerId;
				
				if (!addedRatings.contains(key)) {
					int stars = 2 + ((movieId + ratingOffset) % 4); // Stars: 2-5 (varied ratings)
					int numRatings = 5 + ((movieId * ratingOffset) % 95); // 5-99 ratings per reviewer
					
					if (insertRating(movieId, reviewerId, stars, numRatings, conn) == 0) {
						System.err.println("insertion of Tarantino rating failed");
						break;
					}
					addedRatings.add(key);
				}
			}
			
			if (movieId % 100 == 0) {
				System.out.println("Inserted ratings for Tarantino movie " + movieId);
			}
		}
		
		// 4. Regular ratings for sampled movies (SIGNIFICANTLY REDUCED)
		// Only rate every 20th movie to reduce total insertions from ~2.5M to ~125K
		for (int movieId = 501; movieId <= 100000; movieId += 20) {
			int ratingCount = 3 + (movieId % 5); // 3-7 ratings per movie (reduced from 10-30)
			
			for (int ratingOffset = 0; ratingOffset < ratingCount; ratingOffset++) {
				int reviewerId = 1 + ((movieId * ratingCount + ratingOffset) % 5000);
				String key = movieId + "-" + reviewerId;
				
				if (!addedRatings.contains(key)) {
					int stars = 1 + ((movieId + ratingOffset) % 5); // Stars: 1-5 (full range)
					int numRatings = 1 + ((movieId * ratingOffset) % 99); // 1-99 ratings per reviewer
					
					if (insertRating(movieId, reviewerId, stars, numRatings, conn) == 0) {
						System.err.println("insertion of regular rating " + movieId + " failed");
						break;
					}
					addedRatings.add(key);
				}
			}
			
			if (movieId % 5000 == 1) {
				System.out.println("Inserted ratings for movie " + movieId + " (sampling every 20th movie)");
			}
		}
		System.out.println("Rating population completed with optimized strategy - Total ratings: ~" + addedRatings.size());
	}

