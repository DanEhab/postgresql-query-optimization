	public static void populateMovieDirection(Connection conn) {
		// Create strategic director-movie relationships for meaningful query results
		HashSet<String> addedDirections = new HashSet<>();
		
		// 1. Quentin Tarantino (director 1) directs multiple movies for Query 4C
		// First 500 movies are directed by Quentin Tarantino
		for (int movieId = 1; movieId <= 500; movieId++) {
			String key = "1-" + movieId;
			if (!addedDirections.contains(key)) {
				if (insertMovieDirection(1, movieId, conn) == 0) {
					System.err.println("insertion of Tarantino direction " + movieId + " failed");
					break;
				}
				addedDirections.add(key);
			}
		}
		
		// 2. Multiple directors for Titanic movies (IDs 11-20) for Query 4B
		// Each Titanic movie has 3-5 directors to create shared roles
		for (int movieId = 11; movieId <= 20; movieId++) {
			for (int dirId = 2; dirId <= 6; dirId++) { // Directors 2-6 all work on Titanic movies
				String key = dirId + "-" + movieId;
				if (!addedDirections.contains(key)) {
					if (insertMovieDirection(dirId, movieId, conn) == 0) {
						System.err.println("insertion of Titanic direction failed");
						break;
					}
					addedDirections.add(key);
				}
			}
		}
		
		// 3. Regular director assignments for remaining movies
		// Each director can direct multiple movies, some movies have multiple directors
		for (int movieId = 501; movieId <= 100000; movieId++) {
			// Primary director for each movie
			int primaryDir = (movieId % 6000) + 1;
			String primaryKey = primaryDir + "-" + movieId;
			if (!addedDirections.contains(primaryKey)) {
				if (insertMovieDirection(primaryDir, movieId, conn) == 0) {
					System.err.println("insertion of primary direction " + movieId + " failed");
					break;
				}
				addedDirections.add(primaryKey);
			}
			
			// Some movies have co-directors (every 10th movie)
			if (movieId % 10 == 0 && movieId <= 50000) {
				int coDir = ((movieId / 10) % 6000) + 1;
				String coKey = coDir + "-" + movieId;
				if (coDir != primaryDir && !addedDirections.contains(coKey)) {
					if (insertMovieDirection(coDir, movieId, conn) == 0) {
						System.err.println("insertion of co-direction " + movieId + " failed");
						break;
					}
					addedDirections.add(coKey);
				}
			}
			
			if (movieId % 10000 == 0) {
				System.out.println("Inserted directions for " + movieId + " movies");
			}
		}
		System.out.println("Movie direction population completed with strategic relationships");
	}

	public static void populateMovieCast(Connection conn) {
		// Create strategic actor-movie relationships for meaningful query results
		HashSet<String> addedCast = new HashSet<>();
		
		// 1. Many actors in Toy Story movies (IDs 1-10) for Query 4A
		// Each Toy Story movie has 20-30 actors
		for (int movieId = 1; movieId <= 10; movieId++) {
			for (int actorId = 1; actorId <= 300; actorId++) { // 300 actors across all Toy Story movies
				String key = actorId + "-" + movieId;
				if (!addedCast.contains(key)) {
					String role = "Character" + ((actorId % 10) + 1); // Varied character names
					if (insertMovieCast(actorId, movieId, role, conn) == 0) {
						System.err.println("insertion of Toy Story cast failed");
						break;
					}
					addedCast.add(key);
				}
			}
		}
		
		// 2. Many actors in Titanic movies (IDs 11-20) for Query 4B context
		// Each Titanic movie has 25-35 actors with COMMON role names that will appear in many other movies
		String[] commonRoles = {"Lead Actor", "Supporting Actor", "Villain", "Hero", "Sidekick", 
				"Love Interest", "Mentor", "Comic Relief", "Antagonist", "Protagonist",
				"Main Character", "Secondary Character", "Guest Star", "Cameo", "Extra"};
		
		for (int movieId = 11; movieId <= 20; movieId++) {
			for (int actorId = 301; actorId <= 650; actorId++) { // Different actors from Toy Story
				String key = actorId + "-" + movieId;
				if (!addedCast.contains(key)) {
					// Use common role names that will be reused in many other movies
					String role = commonRoles[(actorId % commonRoles.length)];
					if (insertMovieCast(actorId, movieId, role, conn) == 0) {
						System.err.println("insertion of Titanic cast failed");
						break;
					}
					addedCast.add(key);
				}
			}
		}
		
		// 3. Quentin Tarantino movies (directed by director 1) have specific casting
		// Movies 21-500 directed by Tarantino get premium actors with COMMON role names
		for (int movieId = 21; movieId <= 500; movieId++) {
			// Each Tarantino movie has 10-15 main actors
			for (int actorOffset = 0; actorOffset < 12; actorOffset++) {
				int actorId = 651 + ((movieId * 12 + actorOffset) % 119000); // Distribute across remaining actors
				String key = actorId + "-" + movieId;
				if (!addedCast.contains(key)) {
					// Use the same common role names as Titanic movies to create overlap
					String role = commonRoles[(actorOffset % commonRoles.length)];
					if (insertMovieCast(actorId, movieId, role, conn) == 0) {
						System.err.println("insertion of Tarantino cast failed");
						break;
					}
					addedCast.add(key);
				}
			}
		}
		
		// 4. Regular casting for remaining movies
		// Each movie gets 5-10 actors with COMMON role names to create massive overlap
		for (int movieId = 501; movieId <= 100000; movieId++) {
			int castSize = 5 + (movieId % 6); // 5-10 actors per movie
			for (int castMember = 0; castMember < castSize; castMember++) {
				int actorId = 1 + ((movieId * castSize + castMember) % 120000);
				String key = actorId + "-" + movieId;
				
				if (!addedCast.contains(key)) {
					// Use the same common role names to ensure hundreds of matches with Titanic roles
					String role = commonRoles[(castMember % commonRoles.length)];
					if (insertMovieCast(actorId, movieId, role, conn) == 0) {
						System.err.println("insertion of regular cast " + movieId + " failed");
						break;
					}
					addedCast.add(key);
				}
			}
			
			if (movieId % 10000 == 0) {
				System.out.println("Inserted cast for " + movieId + " movies");
			}
		}
		System.out.println("Movie cast population completed with strategic relationships");
	}

